{
  "name": "mortgage-calculator",
  "version": "2.0.0",
  "private": true,
  "description": "Mortgage calculator: frontend, API contract, Python backend and Supabase.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run dev --workspace frontend --",
    "build": "npm run build --workspace frontend",
    "preview": "npm run preview --workspace frontend --",
    "test": "npm run test --workspace frontend",
    "test:watch": "npm run test:watch --workspace frontend",
    "typecheck": "npm run typecheck --workspace frontend",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "check:scenarios": "node scripts/check-scenarios.ts"
  },
  "lint-staged": {
    "*.{ts,js,mjs,json,css,html,md,yml}": "prettier --write",
    "*.ts": "eslint --fix"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "workspaces": [
    "frontend"
  ]
}
